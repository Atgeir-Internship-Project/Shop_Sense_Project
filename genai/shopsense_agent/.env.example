# Copy to `.env` (gitignored) and fill in.

# --- Gemini access -------------------------------------------------------
# Option A: Vertex AI (recommended - one GCP project for Gemini + BigQuery)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=shop-sense-project
GOOGLE_CLOUD_LOCATION=asia-south1

# Option B: AI Studio API key instead of Vertex
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-aistudio-key

# --- Agent / warehouse -------------------------------------------------
SHOPSENSE_AGENT_MODEL=gemini-3.5-flash-lite
SHOPSENSE_BQ_PROJECT=shop-sense-project
SHOPSENSE_BQ_LOCATION=asia-south1
