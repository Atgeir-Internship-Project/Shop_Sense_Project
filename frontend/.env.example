# Copy to `frontend/.env` (gitignored) and fill in your own values.
# These are read by the existing agent in genai/shopsense_agent - this UI
# does not define any of its own config.

# --- Gemini access (Vertex AI) -------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Option B: AI Studio API key instead of Vertex
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-aistudio-key

# --- Agent / warehouse ---------------------------------------------------
SHOPSENSE_AGENT_MODEL=gemini-3.5-flash-lite
SHOPSENSE_BQ_PROJECT=your-project-id
SHOPSENSE_BQ_LOCATION=asia-south1
